#!/usr/bin/env bash
# SPDX-License-Identifier: LGPL-3.0-only
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
git diff --cached --check
mapfile -d '' -t files < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.cpp' '*.h')
(( ${#files[@]} )) || exit 0

# Read source blobs from the index. Require the style on disk to match the
# staged style, so clang-format cannot silently use an unstaged policy.
if ! cmp -s .clang-format <(git show :.clang-format); then
    echo 'Stage .clang-format before committing C++ files.' >&2
    exit 1
fi
for file in "${files[@]}"; do
    git show ":$file" | "${IMVQML_CLANG_FORMAT:-clang-format}" --style=file:.clang-format \
        --assume-filename="$file" --dry-run --Werror
done
